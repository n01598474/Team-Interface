<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.portal.MainController">

    <top>
        <VBox>
            <ToolBar>
                <Label text="UNFinished Business"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="themeButton" text="Switch Theme"
                        onAction="#handleThemeToggle"/>
                <Button text="A-" onAction="#handleFontDecrease"/>
                <Button text="A+" onAction="#handleFontIncrease"/>
                <CheckBox fx:id="dyslexiaFontCheckBox"
                          text="Dyslexia-Friendly Font"
                          onAction="#handleDyslexiaFontToggle"/>
            </ToolBar>
            <GridPane>
                <columnConstraints>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                </columnConstraints>
                <ToggleButton GridPane.columnIndex="0" maxWidth="Infinity" minWidth="0" maxHeight="Infinity" wrapText="true" textAlignment="CENTER" alignment="CENTER" style="-fx-background-radius: 0; -fx-border-color: -fx-box-border; -fx-border-width: 0 1 1 0;" fx:id="applicantNav"
                              text="Applicant Information"
                              accessibleText="Go to applicant information"/>
                <ToggleButton GridPane.columnIndex="1" maxWidth="Infinity" minWidth="0" maxHeight="Infinity" wrapText="true" textAlignment="CENTER" alignment="CENTER" style="-fx-background-radius: 0; -fx-border-color: -fx-box-border; -fx-border-width: 0 1 1 0;" fx:id="eligibilityNav"
                              text="Work Eligibility"
                              accessibleText="Go to work eligibility"/>
                <ToggleButton GridPane.columnIndex="2" maxWidth="Infinity" minWidth="0" maxHeight="Infinity" wrapText="true" textAlignment="CENTER" alignment="CENTER" style="-fx-background-radius: 0; -fx-border-color: -fx-box-border; -fx-border-width: 0 1 1 0;" fx:id="availabilityNav"
                              text="Availability"
                              accessibleText="Go to availability"/>
                <ToggleButton GridPane.columnIndex="3" maxWidth="Infinity" minWidth="0" maxHeight="Infinity" wrapText="true" textAlignment="CENTER" alignment="CENTER" style="-fx-background-radius: 0; -fx-border-color: -fx-box-border; -fx-border-width: 0 1 1 0;" fx:id="employmentNav"
                              text="Employment History"
                              accessibleText="Go to employment history"/>
                <ToggleButton GridPane.columnIndex="4" maxWidth="Infinity" minWidth="0" maxHeight="Infinity" wrapText="true" textAlignment="CENTER" alignment="CENTER" style="-fx-background-radius: 0; -fx-border-color: -fx-box-border; -fx-border-width: 0 0 1 0;" fx:id="submitNav"
                              text="Submit"
                              accessibleText="Go to submission controls"/>
            </GridPane>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true">
            <content>
                <VBox spacing="12" style="-fx-padding: 20;">

                    <Label text="Employment Application"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                    <Label fx:id="applicantSection" maxWidth="Infinity" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 8 10;" text="Applicant Information"/>
                    <GridPane hgap="10" vgap="10">
                        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Address:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="addressField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Separator/>

                    <Label fx:id="eligibilitySection" maxWidth="Infinity" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 8 10;" text="Work Eligibility"/>
                    <CheckBox fx:id="eligibleCheckBox"
                              text="I am legally eligible to work in the United States"/>
                    <CheckBox fx:id="sponsorshipCheckBox"
                              text="I will require employment sponsorship"/>

                    <Separator/>

                    <Label fx:id="availabilitySection" maxWidth="Infinity" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 8 10;" text="Availability"/>
                    <Label text="Preferred Shift"/>
                    <ComboBox fx:id="shiftComboBox" promptText="Select a shift"/>

                    <Label text="Preferred Weekly Hours"/>
                    <TextField fx:id="weeklyHoursField" promptText="Example: 40"/>

                    <Label text="Available Days"/>
                    <HBox spacing="12">
                        <CheckBox fx:id="mondayCheckBox" text="Monday"/>
                        <CheckBox fx:id="tuesdayCheckBox" text="Tuesday"/>
                        <CheckBox fx:id="wednesdayCheckBox" text="Wednesday"/>
                        <CheckBox fx:id="thursdayCheckBox" text="Thursday"/>
                    </HBox>
                    <HBox spacing="12">
                        <CheckBox fx:id="fridayCheckBox" text="Friday"/>
                        <CheckBox fx:id="saturdayCheckBox" text="Saturday"/>
                        <CheckBox fx:id="sundayCheckBox" text="Sunday"/>
                    </HBox>

                    <Separator/>

                    <Label fx:id="employmentSection" maxWidth="Infinity" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 8 10;" text="Employment History"/>
                    <TableView fx:id="employmentTable" editable="true" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="employerColumn" text="Employer" prefWidth="140"/>
                            <TableColumn fx:id="positionColumn" text="Position" prefWidth="130"/>
                            <TableColumn fx:id="startDateColumn" text="Start Date" prefWidth="100"/>
                            <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="100"/>
                            <TableColumn fx:id="reasonColumn" text="Reason for Leaving" prefWidth="170"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button text="Add Employment" onAction="#handleAddEmployment"/>
                        <Button text="Remove Selected" onAction="#handleRemoveEmployment"/>
                    </HBox>

                    <Separator/>

                    <Label fx:id="submitSection" maxWidth="Infinity" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 8 10;" text="Application Errors"/>
                    <Label fx:id="errorSummaryLabel"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                    <HBox spacing="10">
                        <Button text="Clear Form"
                                onAction="#handleClearForm"/>

                        <Button text="Submit Application"
                                onAction="#handleSubmit"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
